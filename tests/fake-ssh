#!/bin/sh
# Stands in for ssh in the self-test: the "server" is this Mac. Options (-o, and -l from rsync's
# user@host) and the host are dropped; one argument is a shell command (the app's `sh -s`), several
# are a program (rsync's --server end).
while [ "$1" = "-o" ] || [ "$1" = "-l" ]; do shift 2; done
shift
if [ $# -eq 1 ]; then exec /bin/sh -c "$1"; fi
exec "$@"
